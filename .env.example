# Copy the names into .env and fill them in (README, "Keys"). Never commit .env.

# Shared secret the tracker sends as X-Api-Key on /ws/tracker. Set the same value in the tracker's environment.
DESK_TRACKER_KEY=
# The key Ekko's Brain sends as X-Api-Key on POST /api/notes (the Brain's Desk__ApiKey).
DESK_BRAIN_KEY=
# The Brain, for the chat card: its URL, http://127.0.0.1:5065 on the PC (no trailing slash),
# and the desk's own key to it (the Brain's Api__Keys__desk).
EKKO_URL=
EKKO_KEY=
# Ekko.Files, for the Files card and viewers: its URL, http://127.0.0.1:5095 on the PC (the PC's tailnet address in phase 4),
# and the desk's own key to it. The page never sees this key.
FILES_URL=
FILES_KEY=
